# Keycloak Configuration
# Pour tester sur mobile physique, remplacez localhost:8080 par votre URL Cloudflare (ou IP locale)
KEYCLOAK_ISSUER=http://localhost:8080/realms/cook-me
KEYCLOAK_CLIENT_ID=cook-me-api

# Keycloak Admin Credentials (change these for non-local environments)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Postgres Keycloak Credentials (change these for non-local environments)
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=keycloak

# MinIO Configuration
MINIO_USER=minio
MINIO_PASSWORD=minioSecret
MINIO_BUCKET=cook-me-bucket
